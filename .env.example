# Database – Postgres (Supabase in production).
# Supabase: Project Settings → Database → Connection string.
# DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = direct/session (port 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bilkoll"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bilkoll"

# AI – "mock" (default, no network) or "anthropic"
AI_PROVIDER="mock"
AI_MODEL="claude-sonnet-5-5"
ANTHROPIC_API_KEY=""

# Vehicle data – "mock" (default, demo cars) or "biluppgifter" (real Swedish plates, paid API).
# Get a key at https://biluppgifter.se (API / Grundinformation). Without a key the mock is used.
VEHICLE_DATA_PROVIDER="mock"
BILUPPGIFTER_API_KEY=""
