# Database (SQLite in dev, PostgreSQL/Supabase in prod)
DATABASE_URL="file:./dev.db"

# AI – "mock" (default, no network) or "anthropic"
AI_PROVIDER="mock"
AI_MODEL="claude-sonnet-5-5"
ANTHROPIC_API_KEY=""

# Vehicle data adapter – "mock" (default). Real adapters: "biluppgifter" (not implemented yet)
VEHICLE_DATA_PROVIDER="mock"
