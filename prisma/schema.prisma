// BilKoll – Prisma schema
//
// Conventions (see CLAUDE.md):
// - Money: whole SEK as Int, ALWAYS including 25 % moms. Field suffix `Sek`.
// - "Enum" columns are String and validated by the Zod schemas in
//   src/lib/domain.ts. They can become native Postgres enums later.
// - Swedish domain terms are kept where they are the actual concept
//   (regnr, besiktning, Godkänd Bilverkstad); everything else is English.
// - Workshops are REAL businesses. Prices shown for them are BilKoll's
//   ESTIMATES (src/lib/estimate.ts), never stored as if they were the
//   workshop's own prices.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection (Supabase transaction pooler) – used by the app at runtime.
  url       = env("DATABASE_URL")
  /// Direct connection – used by `prisma migrate`.
  directUrl = env("DIRECT_URL")
}

/// A car resolved from a Swedish registration number.
/// Cache of the Transportstyrelsen / Biluppgifter lookup.
model Vehicle {
  id             String    @id @default(cuid())
  /// Normalised: uppercase, no space. "ABC123" or "ABC12D".
  regnr          String    @unique
  make           String
  model          String
  /// Trim / engine variant as marketed, e.g. "D4", "1.4 TSI", "Long Range".
  variant        String?
  year           Int
  /// FuelType: BENSIN | DIESEL | EL | HYBRID | LADDHYBRID | ETANOL | GAS
  fuelType       String
  /// Transmission: MANUELL | AUTOMAT
  transmission   String?
  engineCode     String?
  /// Next mandatory besiktning deadline (sista dag).
  nextInspection DateTime?
  /// Which adapter resolved this record ("mock", "biluppgifter", ...).
  dataSource     String    @default("mock")
  fetchedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quoteAudits QuoteAudit[]
}

/// A real workshop. Public business info only – no prices, no copied ratings.
model Workshop {
  id                   String    @id @default(cuid())
  /// Stable key for seeding/updates, e.g. "speedy-solna".
  slug                 String    @unique
  name                 String
  /// WorkshopChain: MEKONOMEN | MECA | AUTOEXPERTEN | SPEEDY | BOSCH | OKQ8 | BILIA | DIN_BIL | HEDIN | TESLA | INDEPENDENT
  chain                String    @default("INDEPENDENT")
  /// WorkshopTier: MARKESVERKSTAD | KEDJA | FRISTAENDE – drives the price estimate.
  tier                 String
  address              String
  /// Postort, e.g. "Kungens Kurva", "Solna", "Nacka".
  city                 String
  /// Municipality (kommun) – used for "within Stockholm stad" style filters.
  municipality         String
  /// 5 digits, no space: "14175".
  postalCode           String
  /// WGS84 position.
  lat                  Float
  lng                  Float
  /// GeoPrecision: ADDRESS | STREET | POSTAL – how exact lat/lng is.
  geoPrecision         String    @default("POSTAL")
  phone                String?
  website              String?
  /// Trust tier flags. Only true when verified against the official register.
  isGodkandBilverkstad Boolean   @default(false)
  isMrf                Boolean   @default(false)
  /// Auktoriserad märkesverkstad.
  isAuthorized         Boolean   @default(false)
  /// Makes the workshop is authorised for, comma-separated ("Volvo,Polestar").
  authorizedMakes      String?
  /// Where the business details were taken from.
  sourceUrl            String
  /// When the details were last checked against the source.
  verifiedAt           DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  quoteAudits QuoteAudit[]

  @@index([municipality])
  @@index([postalCode])
}

/// Catalogue of standard, comparable jobs and the inputs for estimates.
model StandardService {
  id              String   @id @default(cuid())
  /// e.g. "bas-service", "bromsar-fram", "hjulskifte", "batteribyte", "felsokning"
  slug            String   @unique
  titleSv         String
  descriptionSv   String?
  /// ServiceCategory: SERVICE | BROMSAR | DACK | ELSYSTEM | DIAGNOS
  category        String
  /// Book time ("normaltid") in hours for an average car.
  estimatedHours  Float
  /// Typical parts/consumables for an average car, SEK incl. moms.
  typicalPartsSek Int
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

/// A quote the user received, compared with BilKoll's estimate.
/// Over time these become real price data per workshop and job.
model QuoteAudit {
  id                String    @id @default(cuid())
  regnr             String?
  vehicle           Vehicle?  @relation(fields: [regnr], references: [regnr], onDelete: SetNull)
  workshopId        String?
  workshop          Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  /// StandardService.slug.
  serviceType       String
  /// Raw pasted quote text, kept for re-audits.
  rawText           String?
  quotedHours       Float?
  quotedLaborSek    Int
  quotedPartsSek    Int
  /// Estimate used for the verdict (snapshot, so later model changes don't rewrite history).
  benchmarkHours    Float?
  benchmarkLowSek   Int
  benchmarkTotalSek Int
  benchmarkHighSek  Int
  /// AuditVerdict: BILLIGT | BRA_VARDE | DYRT
  verdict           String
  suspectedUpsell   Boolean   @default(false)
  adviceSv          String
  /// Which AI model produced the advice (traceability).
  aiModel           String?
  createdAt         DateTime  @default(now())

  @@index([regnr])
  @@index([workshopId, serviceType])
}
